{
  "name": "system-documentation-tracker",
  "version": "1.0.0",
  "description": "A JavaScript-only full-stack app for tracking system documentation, review status, and project artifacts.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js --watch server.js --watch . --ext js,json",
    "db:init": "node init-db.js",
    "check": "node --check server.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "documentation",
    "tracker",
    "full-stack",
    "javascript"
  ],
