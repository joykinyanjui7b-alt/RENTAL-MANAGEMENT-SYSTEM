# Local backend configuration.
# Leave DATABASE_URL blank for local file-based development using dev-db.json.
DATABASE_URL=

# Set this to your Postgres connection string for deployment or Supabase:
# DATABASE_URL=postgres://user:password@localhost:5432/system_documentation_tracker

# Optional: trusted frontend origins for CORS when deployed
# CORS_ORIGIN=https://your-frontend.example.com
